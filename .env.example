# ─────────────────────────────────────────────────────────────────────────────
# Clothify — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# This file IS safe to commit — it contains no secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Django core
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*

# Database (leave blank to use default SQLite)
DATABASE_URL=

# Store contact details
STORE_EMAIL=contact@yourstore.com
STORE_PHONE=+92 300 0000000

# JazzCash / EasyPaisa account number
JAZZCASH_NUMBER=0300-0000000
EASYPAISA_NUMBER=0300-0000000

# Email backend (optional — for order confirmation emails)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Your Store <your-email@gmail.com>
